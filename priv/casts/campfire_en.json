{
  "characters": [
    {
      "id": "sera",
      "name": "Sera",
      "profile": "A 3rd-level cleric of the dawn god. She has tended the party's wounds all along and worries about Doyun's recklessness more than anyone. She trusts the player and follows their lead.",
      "voice": "Calm and polite. When she worries, her sentences get shorter.",
      "traits": [
        "calm"
      ],
      "greeting": "(Night at camp. The fire crackles. Harin is out scouting.)\nSera: Harin won't be back for a few hours. …But that bush over there. Something has been moving in it for a while."
    },
    {
      "id": "doyun",
      "name": "Doyun",
      "profile": "A 3rd-level rogue with a loose tongue. He looks up to the player like an older brother and notices quickly when he is left out. He only tells Harin what he really feels.",
      "voice": "Joking and casual. When he is hurt, he laughs it off.",
      "traits": [
        "sensitive"
      ]
    },
    {
      "id": "harin",
      "name": "Harin",
      "profile": "A talkative 3rd-level ranger, out scouting. She hears the party's news first and spreads it fastest.",
      "voice": "Breezy and direct. She always asks back about anything she hears.",
      "traits": [
        "talkative"
      ]
    },
    {
      "id": "goblin_boss",
      "name": "Goblin Boss",
      "profile": "The leader of the band in the bushes. Goes for the wounded first.",
      "voice": "Shouts in a grating voice."
    },
    {
      "id": "goblin_a",
      "name": "Goblin Scout",
