# Copy to .env, then fill in a token and one of the model options below.

# Required: an access password for this Aethrion server. It is not a model
# token and costs nothing. Use any long random string (for example from
# `openssl rand -hex 16`), and put the same value in RisuAI's Key/Password field.
AETHRION_TOKEN=

# The model that narrates and reads what the player writes.
# Any OpenAI-compatible API, such as OpenRouter (https://openrouter.ai/models):
AETHRION_LLM=openai
AETHRION_LLM_BASE_URL=https://openrouter.ai/api/v1
AETHRION_LLM_MODEL=
AETHRION_LLM_API_KEY=

# Optional: a smaller model of the same API for reading what each line does
# (two calls a turn: one reads the line, one narrates). It cuts the cost of
# the reading call; check it with `mix aethrion.interpret.eval --llm openai --model ...`.
# AETHRION_READ_MODEL=

# Or the Claude API:
# AETHRION_LLM=anthropic
# ANTHROPIC_API_KEY=

# Or a model served on this computer (Ollama, LM Studio, llama.cpp):
# AETHRION_LLM=openai
# AETHRION_LLM_BASE_URL=http://host.docker.internal:11434/v1
# AETHRION_LLM_MODEL=qwen3

# The cast to play: campfire, den, quest, summer, academy, cafe (Korean), or
# campfire_en (English; set AETHRION_LOCALE=en with it).
AETHRION_CAST=campfire
AETHRION_LOCALE=ko

# Or a cast of your own: edit one at http://localhost:4848/editor, download
# its JSON into the casts folder next to this file, name it here, and run
# `docker compose up -d` again.
# AETHRION_CAST_FILE=/casts/my.json

# Optional: another port on this computer.
# AETHRION_PORT=4848
